# Line endings.
#
# LF in the repository and in the working copy, whatever core.autocrlf the client happens to
# be set to - without this the endings of a file depend on the machine it was committed from.
* text=auto eol=lf

# ... with the exception of the files cmd.exe reads, which need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# What the package does not ship.
#
# Composer installs a library from the dist archive that GitHub builds with git archive, and
# everything marked here is left out of it: the tests and the CI config are read on GitHub, not
# from vendor/. The package itself is two classes and a config file.
/tests                  export-ignore
/.github                export-ignore
/phpunit.xml.dist       export-ignore
/phpstan.neon.dist      export-ignore
/.php-cs-fixer.dist.php export-ignore
/CONTRIBUTING.md        export-ignore
/.gitignore             export-ignore
/.gitattributes         export-ignore
